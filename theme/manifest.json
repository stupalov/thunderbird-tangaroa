      "tab_text": "rgba(255,255,255,0.95)",
      "tab_line": "#55ADF8",
      "icons": "#8494A3",
      "icons_attention": "#dd491a",
      "button_background_hover": "rgba(255,255,255,0.10)",
      "button_background_active": "rgba(255,255,255,0.16)",
      "popup": "#1A2838",
      "popup_text": "rgba(255,255,255,0.95)",
      "popup_border": "#34455A",
      "popup_highlight": "#55ADF8",
      "popup_highlight_text": "#FFFFFF",
      "sidebar": "#1E2D3F",
      "sidebar_border": "#2C3B4E",
      "sidebar_text": "#F9FAFC",
      "sidebar_highlight": "#55ADF8",
      "sidebar_highlight_text": "#FFFFFF",
      "sidebar_highlight_border": "#55ADF8",
      "tg_bg_primary": "#16222F",
      "tg_bg_secondary": "#1A2838",
      "tg_bg_sidebar": "#1E2D3F",
      "tg_toolbar_top": "#253649",
      "tg_toolbar_bottom": "#1A2838",
      "tg_tab_active": "#1E2D3F",
      "tg_tab_inactive": "#172330",
      "tg_divider_dark": "#34455A",
      "tg_divider_light": "#2C3B4E",
      "tg_selector": "#55ADF8",
      "tg_selector_sidebar": "#55ADF8",
      "tg_selector_inactive": "rgba(255,255,255,0.12)",
      "tg_selector_sidebar_inactive": "rgba(255,255,255,0.12)",
      "tg_selector_thread_inactive": "rgba(255,255,255,0.08)",
      "tg_font_primary": "rgba(255,255,255,0.95)",
      "tg_font_secondary": "#8494A3",
      "tg_font_primary_sidebar": "#F9FAFC",
      "tg_font_secondary_sidebar": "#8494A3",
      "tg_font_primary_selected": "#FFFFFF",
      "tg_font_secondary_selected": "#E3F5FF",
      "tg_font_pending": "rgba(255,255,255,0.5)",
      "tg_text_field_bg": "rgba(255,255,255,0.10)",
      "tg_text_field_border": "transparent",
      "tg_folder_bubble_bg": "#dd491a",
      "tg_folder_bubble_text": "#FFFFFF",
      "tg_unread_dot": "#4AB1FF",
      "tg_icon_get": "#e59349",
      "tg_icon_compose": "#8ab2dc",
      "tg_icon_reply": "#4879a4",
      "tg_icon_archive": "#aa7391",
      "tg_icon_delete": "#bc6764",
      "tg_icon_junk": "#55ADF8",
      "tg_icon_tag": "#b89528"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  },
  "theme_experiment": {
    "stylesheet": "tangaroa.css",
    "colors": {
      "tg_bg_primary": "--tg-bg-primary",
      "tg_bg_secondary": "--tg-bg-secondary",
      "tg_bg_sidebar": "--tg-bg-sidebar",
      "tg_toolbar_top": "--tg-toolbar-top",
      "tg_toolbar_bottom": "--tg-toolbar-bottom",
      "tg_tab_active": "--tg-tab-active",
      "tg_tab_inactive": "--tg-tab-inactive",
      "tg_divider_dark": "--tg-divider-dark",
      "tg_divider_light": "--tg-divider-light",
      "tg_selector": "--tg-selector",
      "tg_selector_sidebar": "--tg-selector-sidebar",
      "tg_selector_inactive": "--tg-selector-inactive",
      "tg_selector_sidebar_inactive": "--tg-selector-sidebar-inactive",
      "tg_selector_thread_inactive": "--tg-selector-thread-inactive",
      "tg_font_primary": "--tg-font-primary",
      "tg_font_secondary": "--tg-font-secondary",
      "tg_font_primary_sidebar": "--tg-font-primary-sidebar",
      "tg_font_secondary_sidebar": "--tg-font-secondary-sidebar",
      "tg_font_primary_selected": "--tg-font-primary-selected",
      "tg_font_secondary_selected": "--tg-font-secondary-selected",
      "tg_font_pending": "--tg-font-pending",
      "tg_text_field_bg": "--tg-text-field-bg",
      "tg_text_field_border": "--tg-text-field-border",
      "tg_folder_bubble_bg": "--tg-folder-bubble-bg",
      "tg_folder_bubble_text": "--tg-folder-bubble-text",
      "tg_unread_dot": "--tg-unread-dot",
      "tg_icon_get": "--tg-icon-get",
      "tg_icon_compose": "--tg-icon-compose",
      "tg_icon_reply": "--tg-icon-reply",
      "tg_icon_archive": "--tg-icon-archive",
      "tg_icon_delete": "--tg-icon-delete",
      "tg_icon_junk": "--tg-icon-junk",
      "tg_icon_tag": "--tg-icon-tag"
    }
  }
}
