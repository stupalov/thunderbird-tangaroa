{
  "manifest_version": 2,
  "name": "Tangaroa",
  "version": "0.2.0",
  "description": "A Thunderbird theme based on Postbox's Tangaroa, with light and dark variants that follow the system.",
  "browser_specific_settings": {
    "gecko": {
      "id": "tangaroa@stupalov.github.io",
      "strict_min_version": "157.0",
      "strict_max_version": "*"
    }
  },
  "icons": {
    "32": "icons/tangaroa-32.png",
    "48": "icons/tangaroa-48.png",
    "64": "icons/tangaroa-64.png"
  },
  "theme": {
    "colors": {
      "frame": "#E2E7EE",
      "frame_inactive": "#E5E9F2",
      "toolbar": "#C5D0DD",
      "toolbar_text": "#1E2D3F",
      "toolbar_field": "#FFFFFF",
      "toolbar_field_text": "#1E2D3F",
      "toolbar_field_border": "#DFE3E7",
      "toolbar_field_focus": "#FFFFFF",
      "toolbar_field_text_focus": "#1E2D3F",
      "toolbar_field_border_focus": "#55ADF8",
      "toolbar_top_separator": "#adb8c4",
      "toolbar_bottom_separator": "#adb8c4",
      "toolbar_vertical_separator": "#adb8c4",
      "tab_selected": "#CBD4E0",
      "tab_background_text": "#1E2D3F",
      "tab_text": "#1E2D3F",
      "tab_line": "#55ADF8",
      "icons": "#5E6C79",
      "icons_attention": "#dd491a",
      "button_background_hover": "rgba(132,146,166,0.35)",
      "button_background_active": "rgba(132,146,166,0.4)",
      "popup": "#F9FAFC",
      "popup_text": "#1E2D3F",
      "popup_border": "#D2D8E6",
      "popup_highlight": "#55ADF8",
      "popup_highlight_text": "#F9FAFC",
      "sidebar": "#1E2D3F",
      "sidebar_border": "#2C3B4E",
      "sidebar_text": "#F9FAFC",
      "sidebar_highlight": "#55ADF8",
      "sidebar_highlight_text": "#F9FAFC",
      "sidebar_highlight_border": "#55ADF8",
      "tg_bg_primary": "#F9FAFC",
      "tg_bg_secondary": "#E5E9F2",
      "tg_bg_sidebar": "#1E2D3F",
      "tg_toolbar_top": "#E2E7EE",
      "tg_toolbar_bottom": "#C5D0DD",
      "tg_tab_active": "#CBD4E0",
      "tg_tab_inactive": "#B9C5D2",
      "tg_divider_dark": "#adb8c4",
      "tg_divider_light": "#D2D8E6",
      "tg_selector": "#55ADF8",
      "tg_selector_sidebar": "#55ADF8",
      "tg_selector_inactive": "rgba(192,204,218,0.6)",
      "tg_selector_sidebar_inactive": "rgba(255,255,255,0.2)",
      "tg_selector_thread_inactive": "#E4E9F3",
      "tg_font_primary": "#1E2D3F",
      "tg_font_secondary": "#5E6C79",
      "tg_font_primary_sidebar": "#F9FAFC",
      "tg_font_secondary_sidebar": "#8494A3",
      "tg_font_primary_selected": "#F9FAFC",
      "tg_font_secondary_selected": "#E5E9F2",
      "tg_font_pending": "#8C96A0",
      "tg_text_field_bg": "#FFFFFF",
      "tg_text_field_border": "#DFE3E7",
      "tg_folder_bubble_bg": "#dd491a",
      "tg_folder_bubble_text": "#FFFFFF",
      "tg_unread_dot": "#4AB1FF",
      "tg_icon_get": "#e59349",
      "tg_icon_compose": "#8ab2dc",
      "tg_icon_reply": "#4879a4",
      "tg_icon_archive": "#aa7391",
      "tg_icon_delete": "#bc6764",
      "tg_icon_junk": "#55ADF8",
      "tg_icon_tag": "#b89528"
    },
    "properties": {
      "color_scheme": "light",
      "content_color_scheme": "light"
    }
  },
  "dark_theme": {
    "colors": {
      "frame": "#253649",
      "frame_inactive": "#1A2838",
      "toolbar": "#1A2838",
      "toolbar_text": "rgba(255,255,255,0.95)",
      "toolbar_field": "rgba(255,255,255,0.10)",
      "toolbar_field_text": "rgba(255,255,255,0.95)",
      "toolbar_field_border": "transparent",
      "toolbar_field_focus": "rgba(255,255,255,0.16)",
      "toolbar_field_text_focus": "#FFFFFF",
